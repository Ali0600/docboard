#!/bin/sh
# Before every push: nothing personal reaches the public remote. It scans every added line,
# message, author address and branch name the push carries, with the private terms from the
# data folder, and refuses the push when that list is missing. Enabled per clone with
# `git config core.hooksPath .githooks`.
cd "$(git rev-parse --show-toplevel)" || exit 1
exec uv run --frozen --quiet docboard privacy --pre-push
